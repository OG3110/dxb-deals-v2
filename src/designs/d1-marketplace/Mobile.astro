---
import './d1.css';
import { WA_GENERAL, WA_SELL, type ClientDeal } from '../../lib/deals';
import { cardHTML, chipsHTML, ICON, SORTS, BUDGETS, stats } from './markup';
interface Props { deals: ClientDeal[] }
const { deals } = Astro.props;
const s = stats(deals);
const IG = 'https://www.instagram.com/dxb.deals/';
---
<div class="d1 d1-m">
  <header class="d1-mhead">
    <a href="#d1-mtop" class="d1-logo" aria-label="DXB Deals – top"><img src="/brand/logo.webp" alt="DXB Deals" width="120" height="40" /></a>
    <a class="d1-mwa" href={WA_GENERAL} target="_blank" rel="noopener" aria-label="WhatsApp Tolga"><Fragment set:html={ICON.wa(22)} /></a>
  </header>

  <main id="d1-mtop">
    <section class="d1-mintro">
      <h1>Buy a <mark>running business</mark> in Dubai</h1>
      <p>{s.total} verified opportunities · from AED {s.from}</p>
    </section>

    <form class="d1-mpill" data-search role="search">
      <label class="d1-mq"><Fragment set:html={ICON.search} /><span class="d1-vh">Search</span>
        <input type="search" data-bind="q" placeholder="Business, area or ID" autocomplete="off" enterkeyhint="search" />
      </label>
      <button type="button" class="d1-mfilter" data-sheet-open aria-label="Sort and budget"><Fragment set:html={ICON.sliders} /></button>
    </form>

    <div class="d1-mchips" data-chips set:html={chipsHTML(deals, 'all')} />

    <section id="d1-mresults" data-results aria-labelledby="d1-mrh">
      <div class="d1-mhd">
        <h2 id="d1-mrh" aria-live="polite" aria-atomic="true"><span data-count>{s.total}</span> <span data-count-label>opportunities</span></h2>
        <button type="button" class="d1-msort" data-sheet-open><Fragment set:html={ICON.sort} /><span data-sort-label>Newest</span></button>
      </div>
      <button type="button" class="d1-clear d1-mclear" data-reset data-filtered hidden>Clear all filters</button>
      <div class="d1-mlist" data-grid set:html={deals.slice(0, 8).map(d => cardHTML(d, false, true)).join('')} />
    </section>

    <section class="d1-msell">
      <h2>Selling your business?</h2>
      <p>Talk to Tolga in confidence.</p>
      <a class="d1-btn d1-btn-gold" href={WA_SELL} target="_blank" rel="noopener">Sell confidentially <Fragment set:html={ICON.arrow} /></a>
    </section>

    <section class="d1-mabout" id="about-m" aria-labelledby="d1-mah">
      <img src="/brand/tolga.webp" alt="Tolga Keklik" width="120" height="120" loading="lazy" decoding="async" />
      <h2 id="d1-mah">Tolga Keklik – Business broker in Dubai</h2>
      <p>Fully fitted, running businesses across Dubai — with the key numbers up front and a direct line to the broker.</p>
      <a class="d1-btn d1-btn-line" href={IG} target="_blank" rel="noopener"><Fragment set:html={ICON.ig} />@dxb.deals</a>
      <small>© 2026 DXB DEALS</small>
    </section>
  </main>

  <nav class="d1-mbar" aria-label="Quick actions">
    <button type="button" class="d1-mbar-saved" data-saved-toggle aria-pressed="false"><Fragment set:html={ICON.heart} /><span>Saved (<span data-saved-count>0</span>)</span></button>
    <a class="d1-btn d1-btn-wa" href={WA_GENERAL} target="_blank" rel="noopener"><Fragment set:html={ICON.wa(18)} />WhatsApp Tolga</a>
  </nav>

  <div class="d1-dim" data-sheet-dim></div>
  <div class="d1-sheet" data-sheet role="dialog" aria-modal="true" aria-labelledby="d1-sh" aria-hidden="true">
    <div class="d1-grab"></div>
    <div class="d1-sheet-hd"><h2 id="d1-sh">Sort &amp; budget</h2><button type="button" class="d1-x" data-sheet-close aria-label="Close">✕</button></div>
    <fieldset><legend>Sort by</legend>
      <div class="d1-opts">{SORTS.map(o => <label class="d1-opt"><input type="radio" name="d1-sort" data-bind="sort" value={o.key} checked={o.key === 'newest'} /><span>{o.label}</span></label>)}</div>
    </fieldset>
    <fieldset><legend>Budget</legend>
      <div class="d1-opts">{BUDGETS.map(b => <label class="d1-opt"><input type="radio" name="d1-budget" data-bind="budget" value={b.key} checked={b.key === ''} /><span>{b.label}</span></label>)}</div>
    </fieldset>
    <button type="button" class="d1-go" data-sheet-close>Show <span data-count>{s.total}</span> <span data-results-label>results</span></button>
  </div>
</div>

<script>
  import { initMobile } from './d1';
  const wrap = document.querySelector<HTMLElement>('[data-version=mobile]');
  if (wrap) {
    if (document.documentElement.dataset.view === 'mobile') initMobile(wrap.querySelector<HTMLElement>('.d1-m')!);
    else wrap.remove(); // inactive version: drop it so only one set of [data-deal-id] cards exists
  }
</script>
