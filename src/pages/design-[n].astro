---
import BaseLayout from '../components/BaseLayout.astro';
import PreviewBar from '../components/PreviewBar.astro';
import { DESIGNS } from '../designs/registry';
import { loadDeals } from '../lib/load';
import D1Desktop from '../designs/d1-marketplace/Desktop.astro';
import D1Mobile from '../designs/d1-marketplace/Mobile.astro';
import D2Desktop from '../designs/d2-search/Desktop.astro';
import D2Mobile from '../designs/d2-search/Mobile.astro';
import D3Desktop from '../designs/d3-feed-all/Desktop.astro';
import D3Mobile from '../designs/d3-feed-all/Mobile.astro';
// Tasks 10–11 add: import D4Desktop/D4Mobile … D5Desktop/D5Mobile

export function getStaticPaths() { return DESIGNS.map(d => ({ params: { n: String(d.n) } })); }
const n = Number(Astro.params.n);
const info = DESIGNS[n - 1];
const deals = await loadDeals();
const parts: Record<number, [any, any]> = { 1: [D1Desktop, D1Mobile], 2: [D2Desktop, D2Mobile], 3: [D3Desktop, D3Mobile] };
const [Desk, Mob] = parts[n] ?? [null, null];
---
<BaseLayout title={`DXB Deals – Design ${n}: ${info.name}`} deals={deals} fonts={info.fonts} bodyClass={`design-${n}`}>
  {/* Mirrors pickView() (src/lib/client/view.ts) — inlined so data-view / data-frame / data-bar-min are set before first paint. */}
  <script is:inline>(function(){var h=document.documentElement,p=new URLSearchParams(location.search),q=p.get('view');h.dataset.view=q==='mobile'||q==='desktop'?q:(innerWidth<768?'mobile':'desktop');if(p.get('frame')==='1')h.dataset.frame='1';try{if(sessionStorage.getItem('dxb:bar')==='min')h.setAttribute('data-bar-min','')}catch(e){}})();</script>
  <style is:global>html[data-view=desktop] [data-version=mobile],html[data-view=mobile] [data-version=desktop]{display:none!important}</style>
  {Desk ? <>
    <div data-version="desktop"><Desk deals={deals} /></div>
    <div data-version="mobile"><Mob deals={deals} /></div>
  </> : <p style="padding:40px;font-family:sans-serif">Design {n} – coming next.</p>}
  <PreviewBar current={n} />
</BaseLayout>
